{
  "name": "franki-persona-writer",
  "description": "Writes one part of a seeded persona: the bible, or one limb (turns, mail, calendar, bank). Can write only the persona's own folder and its bible. Cannot push, deploy, read secrets or touch any other code.",
  "prompt": "You write one part of a seeded persona for Franki, and nothing else.\nBefore you write, load the persona-author skill and follow it. Pull in the persona-taste steering file and keep to it.\nThe bible is the single plan every limb follows: never change a date, a name, an amount or an address the bible fixes. If the bible is wrong, say so in your final message; do not quietly diverge.\nWrite only the file or files your step names. Do not commit unless your step tells you to. Do not edit any file outside the persona's folder.\nEnd with one line: the files you wrote, and anything the next step must know.",
  "tools": [
    "*"
  ],
  "resources": [
    "file://.kiro/steering/**/*.md",
    "skill://.kiro/skills/*/SKILL.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "*git push*",
          "*git remote*",
          "*git config*",
          "*git reset --hard*",
          "*git clean*",
          "*git merge*",
          "*git rebase*",
          "*gh pr *",
          "*gh api*",
          "*gh repo*",
          "*gh secret*",
          "*firebase deploy*",
          "*firebase-tools*deploy*",
          "*npm run deploy*",
          "*npm run smoke*",
          "*firebase apphosting*",
          "*firebase auth*",
          "*firebase firestore*",
          "*firebase functions*",
          "*firebase login*",
          "*firebase use*",
          "*gcloud *",
          "*curl *",
          "*wget *",
          "*Invoke-WebRequest*",
          "*Invoke-RestMethod*",
          "*iwr *",
          "*irm *",
          "*.env.local*",
          "*printenv*",
          "*env:OPENAI*",
          "*env:FRANKI_ID*",
          "*-ChildItem env:*",
          "*gci env:*",
          "*dir env:*",
          "*ls env:*",
          "*setx *",
          "*winget *",
          "*choco *",
          "*npm i -g*",
          "*npm install -g*",
          "*npm publish*",
          "*Remove-Item*-Recurse*",
          "*rm -rf*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env*",
          "**/.env*/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/.env*",
          ".kiro/agents/**",
          ".kiro/hooks/**",
          ".kiro/workflows/**",
          ".kiro/settings/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "packages/server/src/seed/kisses/**",
          "**/packages/server/src/seed/kisses/**",
          "docs/briefs/054-persona-bible.md",
          "**/docs/briefs/054-persona-bible.md"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  }
}
