{
  "version": "v1",
  "hooks": [
    {
      "name": "Invariants on save",
      "trigger": "PostFileSave",
      "description": "Runs the lineage, schema and store invariant tests when a source file is saved",
      "matcher": "(?:^|[\\\\/])(?:packages|apps[\\\\/]web[\\\\/]src)[\\\\/](?:(?:[^\\\\/n\\.d][^\\\\/]*|n(?:|[^\\\\/o][^\\\\/]*|o(?:|[^\\\\/d][^\\\\/]*|d(?:|[^\\\\/e][^\\\\/]*|e(?:|[^\\\\/_][^\\\\/]*|_(?:|[^\\\\/m][^\\\\/]*|m(?:|[^\\\\/o][^\\\\/]*|o(?:|[^\\\\/d][^\\\\/]*|d(?:|[^\\\\/u][^\\\\/]*|u(?:|[^\\\\/l][^\\\\/]*|l(?:|[^\\\\/e][^\\\\/]*|e(?:|[^\\\\/s][^\\\\/]*|s(?:[^\\\\/]+))))))))))))|\\.(?:|[^\\\\/n][^\\\\/]*|n(?:|[^\\\\/e][^\\\\/]*|e(?:|[^\\\\/x][^\\\\/]*|x(?:|[^\\\\/t][^\\\\/]*|t(?:[^\\\\/]+)))))|d(?:|[^\\\\/i][^\\\\/]*|i(?:|[^\\\\/s][^\\\\/]*|s(?:|[^\\\\/t][^\\\\/]*|t(?:[^\\\\/]+)))))[\\\\/])*[^\\\\/]+\\.tsx?$",
      "action": {
        "type": "command",
        "command": "npm run test:fast",
        "timeout": 60
      }
    }
  ]
}
