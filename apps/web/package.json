  "description": "Franki's web app: the front door, the lab and the API routes (Next.js on Firebase App Hosting).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OracleOfAggieland/frankirocks.git",
    "directory": "apps/web"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
