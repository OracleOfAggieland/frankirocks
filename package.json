{
  "name": "frankirocks",
  "version": "0.0.0",
  "private": true,
  "description": "Franki, an avatar-first, voice-first life assistant. Kiroween 2026 entry.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@franki/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:emulator": "npx -y firebase-tools@15.34.2 emulators:exec --only firestore --project demo-franki \"vitest run --config vitest.emulator.config.ts\"",
    "smoke": "node tests/smoke.mjs",
    "deploy": "npx -y firebase-tools@15.34.2 deploy --only firestore,functions,apphosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "firebase": "13.1.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
